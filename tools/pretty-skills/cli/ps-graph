#!/usr/bin/env bash
# ps-graph · 扫描所有 skill 的 manifest，输出 Mermaid 依赖图

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PS_ROOT="${PS_ROOT:-$HOME/.pretty-skills}"
LIB="$PS_ROOT/store/pretty-skills/lib/common.sh"
[ ! -f "$LIB" ] && LIB="$SCRIPT_DIR/../lib/common.sh"
# shellcheck source=../lib/common.sh
source "$LIB"

PS_STORE_DIR="$PS_STORE"

echo "graph LR"
echo "  %% generated by ps graph on $(date +%Y-%m-%d)"
echo

# 收集所有 skill 和它们声明的依赖
for manifest in "$PS_STORE_DIR"/*/manifest.yaml; do
  [ -f "$manifest" ] || continue
  skill_name=$(basename "$(dirname "$manifest")")
  # 跟随 symlink
  if [ -L "$manifest" ]; then
    skill_name=$(basename "$(dirname "$(readlink "$manifest")")")
  fi

  # 声明该 skill（作为节点）
  echo "  $skill_name[\"$skill_name\"]"

  # 解析 dependencies 列表（简单 awk 解析）
  # 跳过 dependencies: 主行，找缩进更深的 name:
  deps=$(awk '
    /^dependencies:[[:space:]]*$/ { in_dep=1; next }
    in_dep && /^[^[:space:]-]/ { in_dep=0 }
    in_dep && /^[[:space:]]+-?[[:space:]]*name:[[:space:]]*/ {
      sub(/^[[:space:]]+-?[[:space:]]*name:[[:space:]]*/, "")
      gsub(/["'\'']/, "")
      print
    }
  ' "$manifest")

  for dep in $deps; do
    echo "  $skill_name --> $dep"
  done
done

echo
echo "  %% 风格（按类别着色）"
echo "  classDef manager fill:#7c3aed,stroke:#5b21b6,color:#fff"
echo "  classDef creator fill:#0891b2,stroke:#0e7490,color:#fff"
echo "  classDef domain fill:#f59e0b,stroke:#b45309,color:#000"
echo
echo "  class pretty-skills manager"
echo "  class pretty-skills-creator creator"
